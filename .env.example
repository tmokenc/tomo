# ==========================================
#  Tomo bot configuration
#  Copy to `.env` and fill in your secrets.
# ==========================================

# ---- Required ----
DISCORD_TOKEN=your-discord-bot-token-goes-here

# ---- Bot behaviour ----
# Prefix used for prefix-style commands. May be a single string.
TOMO_PREFIX=tomo>
# A separate prefix only the bot owner can use (master commands). Optional.
TOMO_MASTER_PREFIX=%
# Comma separated user IDs allowed to use master commands. Defaults to bot owner.
TOMO_OWNERS=
# Activity status shown in Discord. Optional. Quote values that contain spaces.
TOMO_ACTIVITY="Watching scripts/"

# ---- Toggles (true|false) ----
TOMO_ENABLE_PREFIX=true
TOMO_ENABLE_SLASH=true
TOMO_ENABLE_GEMINI=true
TOMO_ENABLE_AUTO_TRIGGERS=true
TOMO_ENABLE_HOT_RELOAD=true
# Register slash commands globally. If false, set TOMO_DEV_GUILD to a guild id.
TOMO_REGISTER_GLOBAL=false
TOMO_DEV_GUILD=

# How long the gallery-lookup auto-triggers (nhentai / ehentai) wait for a
# user to click the reaction before giving up and removing it. Seconds.
TOMO_GALLERY_LOOKUP_WAIT_SECS=30

# ---- Paths ----
# Directory the embedded KV database (fjall) writes to. Will be created on first run.
TOMO_DATA_DIR=./data
# Directory where Rhai scripts live. See scripts/README.md.
TOMO_SCRIPT_DIR=./scripts

# ---- Gemini ----
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Comma-separated fallback chain. The bot tries each model in order and
# rotates to the next on a 429 (rate limit), bringing the parked model back
# in rotation after the cooldown Google returns (or 60 s if no hint).
#
# Free-tier as of 2026-05 (per ai.google.dev/gemini-api/docs/pricing):
#   gemini-2.5-flash         10 RPM ×  250 RPD  (balanced default)
#   gemini-3-flash-preview   10 RPM ×  100 RPD  (newer flash, preview)
#   gemini-2.5-flash-lite    15 RPM × 1000 RPD  (cheapest, fastest)
#   gemini-2.5-pro            5 RPM ×  100 RPD  (best quality, slowest)
GEMINI_MODEL=gemini-2.5-flash,gemini-3-flash-preview,gemini-2.5-flash-lite,gemini-2.5-pro
# How many recent messages from the channel to include as context.
GEMINI_CONTEXT_MESSAGES=10
# Max output tokens.
GEMINI_MAX_OUTPUT_TOKENS=1024
# Per-user rate limit (requests per minute).
GEMINI_RATE_LIMIT=6
# A short system instruction that shapes how the bot answers.
# Must be quoted because it contains whitespace.
GEMINI_SYSTEM_PROMPT="You are Tomo, a helpful Discord bot. Reply concisely."

# ---- OCR (`ocr` command) ----
# Two optional engines. Configure either or both; if both are set, the OCR
# command runs each engine in turn and merges the output.
#
# Latin engine covers English, Czech, Vietnamese, and most European scripts
# (via `latin_PP-OCRv5_mobile_rec` from PaddleOCR).
# CJK engine covers Simplified/Traditional Chinese, Japanese, and English
# (via the default `ch_PP-OCRv5_*` models).
#
# Configuring BOTH gets you all 5 languages we promise (en / cs / vi / zh / ja).
# Model downloads: https://github.com/zibo-chen/rust-paddle-ocr#models
TOMO_OCR_LATIN_DET=
TOMO_OCR_LATIN_REC=
TOMO_OCR_LATIN_KEYS=
TOMO_OCR_CJK_DET=
TOMO_OCR_CJK_REC=
TOMO_OCR_CJK_KEYS=

# ---- gRPC control plane (tomo-discord exposes this) ----
TOMO_ENABLE_RPC=true
# Bind address. Keep this on localhost unless you have a TLS reverse proxy.
TOMO_RPC_BIND=127.0.0.1:50051
# Optional bearer token. The admin service must use the same value via TOMO_RPC_TOKEN.
TOMO_RPC_TOKEN=

# ---- Admin web service ----
TOMO_ENABLE_ADMIN=false
TOMO_ADMIN_BIND=127.0.0.1:8080
# URL the admin service uses to reach the bot's gRPC. Usually the same machine.
TOMO_RPC_URL=http://127.0.0.1:50051
# 32+ byte random string. `openssl rand -hex 32` or similar.
TOMO_ADMIN_SESSION_SECRET=
# How many hours a sign-in lasts. Clamped to [1, 168].
TOMO_ADMIN_SESSION_HOURS=24
# Directory holding the compiled Yew frontend (`trunk build` output).
TOMO_ADMIN_FRONTEND=./frontend/dist
# Disable in dev only; the bot wants HSTS on every production response.
TOMO_ADMIN_ENABLE_HSTS=true

# ---- Discord OAuth (used by tomo-admin) ----
# https://discord.com/developers/applications -> your app -> OAuth2.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Must match the redirect URL configured in the Discord dev portal exactly.
DISCORD_OAUTH_REDIRECT_URL=http://127.0.0.1:8080/oauth/callback

# ---- Logging ----
# Standard tracing-subscriber filter.
RUST_LOG=info,tomo=debug,twilight_gateway=info
